# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the two values from app.xtrace.ai
#   Settings -> API Keys
# Without them Mise runs its offline stand-in, which is fine for a dry run.
# ---------------------------------------------------------------------------

XTRACE_API_KEY=xtk_paste_your_key_here

# The memory SDK derives your org from the key, so this is optional there.
# The x-vec vault and the raw HTTP API still want it, so fill it in if you have it.
XTRACE_ORG_ID=org_paste_your_org_id_here

# Staging instead of production, if you were given a staging key:
# XTRACE_BASE_URL=https://api.staging.xtrace.ai

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# The working context directives are written under and recalled from.
MISE_NAMESPACE=verano:service

# The encrypted vault. Leave these alone unless you are running vault/service.py.
MISE_VAULT_URL=http://127.0.0.1:8787
# Changing this invalidates any vault already written under the old value —
# AES-GCM refuses to open rather than decrypting to garbage. Delete .mise/ if
# you change it; npm run seed rebuilds the vault from data/.
MISE_VAULT_PASSPHRASE=mise-demo-passphrase
# MISE_VAULT_KB_ID=

# Force the offline stand-in even when credentials are present.
# MISE_OFFLINE=1

# Ingest inline (one connection held up to 30s) instead of submit-and-poll.
# Faster when the network allows it; the default async path is what survives
# VPNs and proxies that reset long-lived connections.
# MISE_SYNC_INGEST=1
